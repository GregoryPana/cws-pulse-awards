[Unit]
Description=CWS Pulse Awards Backend
After=network.target

[Service]
Type=exec
User=pulse
WorkingDirectory=/opt/pulse-awards/backend
EnvironmentFile=/opt/pulse-awards/.env
ExecStart=/opt/pulse-awards/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${BACKEND_PORT} --workers 2
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
