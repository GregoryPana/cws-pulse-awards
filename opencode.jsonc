{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["OPENCODE.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
