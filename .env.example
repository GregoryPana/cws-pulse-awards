# CWS Pulse Awards — Environment Variables
# Copy to .env and fill in all values before starting the backend service
# .env lives at /opt/pulse-awards/.env on the VM
# Never commit .env to version control — it is in .gitignore

# ── APPLICATION ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=0.1.0
APP_SECRET_KEY=
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"

ADMIN_ROLE=CWS-Pulse-Admin
# Backend app role required for admin API access

DEV_AUTH_ENABLED=false
# Local testing only. When true, backend accepts bearer token "local-dev-admin" for admin APIs.
# Must remain false in staging and production.

# ── DATABASE ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=pulse_awards
DB_USER=pulse
DB_PASSWORD=
# Strong random password for the pulse PostgreSQL user
# Used by docker-compose.yml to set POSTGRES_PASSWORD

DATABASE_URL=postgresql+asyncpg://pulse:CHANGE_ME@127.0.0.1:5433/pulse_awards
# Host port 5433 — DTO standard (04_DOCKER_COMPOSE_STANDARD.md)
# 127.0.0.1 — backend is on the same VM as the Docker Compose PostgreSQL service
# Replace CHANGE_ME with the same value as DB_PASSWORD

# ── MICROSOFT ENTRA ID (BACKEND) ──────────────────────────────────────────────
ENTRA_TENANT_ID=
# Azure AD tenant ID — found in Entra portal under App registrations > Overview

ENTRA_CLIENT_ID=
# App registration client ID — found in Entra portal under App registrations > Overview

ENTRA_AUTHORITY=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID
# Replace REPLACE_WITH_TENANT_ID with the value of ENTRA_TENANT_ID

ENTRA_ISSUER=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
# Replace REPLACE_WITH_TENANT_ID with the value of ENTRA_TENANT_ID
# Backend validates JWT issuer against this value

ENTRA_AUDIENCE=api://REPLACE_WITH_CLIENT_ID
# Replace REPLACE_WITH_CLIENT_ID with the value of ENTRA_CLIENT_ID
# Backend validates JWT audience against this value
# Wrong value here causes 401 on every authenticated API call

ENTRA_JWKS_URL=
# Optional — leave blank to fall back to Entra discovery endpoint automatically
# If set, use: https://login.microsoftonline.com/{tenant_id}/discovery/v2.0/keys
# Backend must treat a blank value as unset and fall back safely (SOP 06)

# ── SMTP (CWS INTERNAL RELAY) ─────────────────────────────────────────────────
SMTP_HOST=172.16.77.10
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=3
SMTP_FROM=noreply@cwseychelles.com
# Confirm SMTP_FROM with CWS IT before first email send

# ── STORAGE ───────────────────────────────────────────────────────────────────
PHOTO_STORAGE_PATH=/data/pulse/photos
# Must exist and be writable by the pulse service user before first run:
# sudo mkdir -p /data/pulse/photos && sudo chown pulse:pulse /data/pulse/photos

# ── PDF SERVICE ───────────────────────────────────────────────────────────────
PDF_SERVICE_URL=http://127.0.0.1:8001
# Playwright sidecar bound to localhost only — docker-compose.yml port mapping
# Do not change unless Playwright container port mapping changes

# ── APP ORIGIN (backend-side) ──────────────────────────────────────────────────
# cwscx-tst01 is a shared VM: Pulse Awards has no domain of its own there, so it
# is served as a path under the shared host's existing NGINX config, not its own
# vhost. Includes the URL_PATH_PREFIX (see below) — do not drop it.
APP_BASE_URL=https://cwscx-tst01.cwsey.com/pulse-awards
# The frontend's own reachable origin, read by the BACKEND (unlike the VITE_ vars
# below) to build absolute static asset URLs — currently the logo and the Golden
# Ticket artwork — used in emails and the browser-rendered admin preview. Must
# match wherever the frontend's public/ folder is actually served in this
# environment. Local dev: http://127.0.0.1:5173

PDF_ASSET_BASE_URL=https://cwscx-tst01.cwsey.com/pulse-awards
# Same asset URLs as above, but used when the PDF sidecar (a separate Docker
# container) renders a certificate — its own network namespace cannot resolve
# 127.0.0.1 as the host machine. In production this is identical to
# APP_BASE_URL since everything sits behind one real domain. Local dev only:
# http://host.docker.internal:5173 (requires vite.config.ts server.host: true)

# ── URL PATH PREFIX (path-based hosting on the shared VM) ─────────────────────
URL_PATH_PREFIX=/pulse-awards
# cwscx-tst01 already runs other apps under ONE shared hostname + NGINX config,
# each mounted at its own path (/dashboard/, /surveys/, /system-check/, etc).
# Pulse Awards follows the same convention rather than getting its own vhost —
# see docs/deployment/self-hosted-runner-setup.md and
# docs/deployment/shared-vm-inventory.md. Leave blank ("") only if this app is
# ever given its own dedicated domain/vhost instead.

# ── FRONTEND BUILD ARGS (VITE) ────────────────────────────────────────────────
# These are baked into the frontend at build time — not loaded at runtime
# Changing any VITE_ variable requires a frontend rebuild and redeploy
# scripts/linux/build_release_bundle.sh derives these from SERVER_NAME/URL_PATH_PREFIX
# automatically — you do not need to set VITE_API_BASE_URL/VITE_APP_URL/VITE_BASE_PATH
# as separate GitHub Environment variables.

VITE_BASE_PATH=/pulse-awards/
# Vite's `base` build option — must end in a slash. Empty/"/" for local dev.

VITE_API_BASE_URL=https://cwscx-tst01.cwsey.com/pulse-awards/api/v1
VITE_APP_URL=https://cwscx-tst01.cwsey.com/pulse-awards
# Must match the redirect URI registered in the Entra app registration exactly

VITE_ENTRA_CLIENT_ID=
# Same value as ENTRA_CLIENT_ID

VITE_ENTRA_TENANT_ID=
# Same value as ENTRA_TENANT_ID

VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID
# Same pattern as ENTRA_AUTHORITY

VITE_ENTRA_API_SCOPE=api://REPLACE_WITH_CLIENT_ID/access_as_user
# Replace REPLACE_WITH_CLIENT_ID with ENTRA_CLIENT_ID
# This scope must be registered under Expose an API in the Entra app registration

VITE_DEV_AUTH_ENABLED=false
# Local testing only. When true, frontend admin pages call admin APIs with bearer token "local-dev-admin" instead of MSAL.
# Must remain false in staging and production.
